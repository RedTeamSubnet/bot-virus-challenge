ENV=LOCAL
DEBUG=false
# TZ=Asia/Seoul
# PYTHONDONTWRITEBYTECODE=1


## -- Challenge API Service (challenge-api container) --
BV_CHALLENGE_API_PORT=10001
# BV_CHALLENGE_API_LOGS_DIR="/var/log/rest-bv-challenge"
# BV_CHALLENGE_API_DATA_DIR="/var/lib/rest-bv-challenge"
# BV_CHALLENGE_API_DOCS_ENABLED=true

## -- Challenge API Runtime & Authentication --
# Generate with: openssl rand -hex 20 | tr -d '\n' | head -c 32
BV_CHALLENGE_API_KEY="some-secret-key"

## -- Cross-VM Communication: Challenge → Bot-Runner --
BV_BOT_RUNNER_ENDPOINT="http://bv-bot-runner:8000"
BV_BOT_RUNNER_KEY="some-secret-key"
# BV_CHALLENGE_BOT_TIMEOUT=120
