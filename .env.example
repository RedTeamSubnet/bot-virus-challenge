## --- Environment variable --- ##
ENV=LOCAL
DEBUG=false
# TZ=Asia/Seoul
# PYTHONDONTWRITEBYTECODE=1


## -- API configs -- ##
BV_CHALLENGE_API_PORT=10001
# BV_CHALLENGE_API_CONFIGS_DIR="/etc/rest-bv-challenge"
# BV_CHALLENGE_API_LOGS_DIR="/var/log/rest-bv-challenge"
# BV_CHALLENGE_API_DATA_DIR="/var/lib/rest-bv-challenge"
# BV_CHALLENGE_API_TMP_DIR="/tmp/rest-bv-challenge"
# BV_CHALLENGE_API_VERSION="1"
# BV_CHALLENGE_API_PREFIX=""
# BV_CHALLENGE_API_DOCS_ENABLED=true
# BV_CHALLENGE_API_DOCS_OPENAPI_URL="{api_prefix}/openapi.json"
# BV_CHALLENGE_API_DOCS_DOCS_URL="{api_prefix}/docs"
# BV_CHALLENGE_API_DOCS_REDOC_URL="{api_prefix}/redoc"

## -- Challenge-API runtime -- ##
# Single auth secret for /score and /payload endpoints.
BV_CHALLENGE_API_KEY="replace-with-api-key-123"
# Timeout (seconds) /score waits for scorer to POST /payload.
# BV_CHALLENGE_BOT_TIMEOUT=120
# BV_CHALLENGE_VM_ENDPOINT="http://bot-runner:8000"

## -- Scorer (rt-score) configs -- ##
RTS_API_PORT=8000
# Scorer posts back to challenge-api using CHALLENGE_API_URL + BV_CHALLENGE_API_KEY.
# CHALLENGE_API_URL="http://challenge-api:10001"
# RTS_API_CONFIGS_DIR="/etc/rest-rt-score"
# RTS_API_LOGS_DIR="/var/log/rest-rt-score"
# RTS_API_DATA_DIR="/var/lib/rest-rt-score"

## -- Web page (login page) configs -- ##
WEB_PAGE_PORT=3000

## -- Bot-runner (DinD) configs -- ##
MDM_CHALLENGE_BASE_URL="http://challenge-api:10001"
# MDM_CHALLENGE_CHALLENGE_WEB_URL="http://web-page/"
# MDM_CHALLENGE_CHALLENGE_NETWORK_NAME="bot-challenge-network"
# MDM_CHALLENGE_MINER_IMAGE_TAG="redteamsubnet/bv-miner:latest"
