FROM python:3.12-slim
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99 CHROME_BIN=/usr/bin/chromium
ENV RTK_PAIR_MODE=suppress_mouse RTK_OS_POINTER=1 PYTHONPATH=/app/lib
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium xvfb x11-utils xdotool \
        fonts-liberation fonts-dejavu-core ca-certificates \
        libnss3 libatk-bridge2.0-0 libgtk-3-0 libx11-xcb1 \
        libxcb-dri3-0 libdrm2 libgbm1 libasound2 libegl1 \
        libgles2 libgl1-mesa-dri mesa-utils \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "nodriver==0.50.3" \
    && mkdir -p /app/lib \
    && printf '' > /app/lib/__init__.py \
    && rm -f /app/lib/rtk_cfg.py.b64 \
    && printf '%s' '' > /app/lib/rtk_cfg.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_cfg.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_cfg.py.b64 \
    && base64 -d /app/lib/rtk_cfg.py.b64 > /app/lib/rtk_cfg.py \
    && rm -f /app/lib/rtk_cfg.py.b64 \
    && rm -f /app/lib/rtk_motion.py.b64 \
    && printf '%s' '' > /app/lib/rtk_motion.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_motion.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_motion.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_motion.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_motion.py.b64 \
    && base64 -d /app/lib/rtk_motion.py.b64 > /app/lib/rtk_motion.py \
    && rm -f /app/lib/rtk_motion.py.b64 \
    && rm -f /app/lib/rtk_pointer.py.b64 \
    && printf '%s' '' > /app/lib/rtk_pointer.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_pointer.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_pointer.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_pointer.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_pointer.py.b64 \
    && base64 -d /app/lib/rtk_pointer.py.b64 > /app/lib/rtk_pointer.py \
    && rm -f /app/lib/rtk_pointer.py.b64 \
    && rm -f /app/lib/rtk_session.py.b64 \
    && printf '%s' '' > /app/lib/rtk_session.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_session.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_session.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_session.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_session.py.b64 \
    && base64 -d /app/lib/rtk_session.py.b64 > /app/lib/rtk_session.py \
    && rm -f /app/lib/rtk_session.py.b64 \
    && rm -f /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' > /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && printf '%s' '' >> /app/lib/rtk_spoof.py.b64 \
    && base64 -d /app/lib/rtk_spoof.py.b64 > /app/lib/rtk_spoof.py \
    && rm -f /app/lib/rtk_spoof.py.b64
WORKDIR /app
COPY bot /app/bot
COPY bot_runner.py /app/bot_runner.py
CMD ["sh", "-c", "Xvfb :99 -screen 0 2560x1440x24 -ac +extension RANDR >/tmp/xvfb.log 2>&1 & sleep 1 && exec python bot_runner.py"]
